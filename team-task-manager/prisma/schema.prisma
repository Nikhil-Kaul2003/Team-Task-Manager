generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id       String      @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     Role
}

model Project {
  id      Int    @id @default(autoincrement())
  name    String
}

model Task {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  MEMBER
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}